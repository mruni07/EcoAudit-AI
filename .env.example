# EcoAudit AI — Environment Configuration
# Copy this file to .env and replace placeholder values with your actual credentials.
# NEVER commit the .env file to version control.

# ─── OpenAI Responses API (default) ───
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Model must be in a supported OpenAI Responses API family.
OPENAI_MODEL=gpt-4.1-mini

# ─── Google Gemini API (optional alternative) ───
# If both keys are configured, Google Gemini is selected first to preserve
# the existing provider priority. Otherwise OpenAI is used.
# Get a key from: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_MODEL=gemini-3.8-flash
